# RocketLab environment configuration
# Copy this file to .env and edit values for your deployment

# API
API_V1_STR=/api/v1
PROJECT_NAME=RocketLab
VERSION=0.1.0

# CORS - restrict in production
BACKEND_CORS_ORIGINS=*

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://rocketlab:rocketlab@localhost:5432/rocketlab

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=admin-change-me
WORKER_TOKEN=worker-change-me

# Demo data seeding on startup
SEED_DEMO_DATA=true
